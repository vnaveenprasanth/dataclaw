# Flask
FLASK_ENV=development
SECRET_KEY=generate-with-python-secrets-token-hex-32

# Database (Supabase — Transaction mode pooler)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Clerk JWT verification (backend only — NEVER expose in frontend)
# Get from: Clerk Dashboard -> API keys -> JWT Verification Key
CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...paste PEM key here...
-----END PUBLIC KEY-----"

# Origins permitted to make requests (azp claim validation — prevents CSRF)
CLERK_PERMITTED_ORIGINS=http://localhost:5173

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173

# ── LLM — Primary (Gemini) ──────────────────────────────────────────────────
# Get from: https://aistudio.google.com -> Get API Key
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# ── LLM — Fallback (OpenAI — optional) ─────────────────────────────────────
# Set to false if you don't have an OpenAI key
LLM_FALLBACK_ENABLED=true
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o-mini
