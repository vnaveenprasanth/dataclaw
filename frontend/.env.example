# Clerk — publishable key (safe to expose)
# Get from: Clerk Dashboard -> API keys -> Quick Copy
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# API URL — leave empty to use Vite dev proxy (/api -> http://localhost:5000)
# In production, set this to your EC2 backend URL:
# VITE_API_URL=http://your-ec2-ip/api
